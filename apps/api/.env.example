APP_NAME=Fikarohana
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Non-production credentials for infra/docker/compose.yml only.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=fikarohana
DB_USERNAME=fikarohana_dev
DB_PASSWORD=fikarohana_dev_only
DB_SSLMODE=prefer

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_MOBILE_TOKEN_EXPIRATION=43200

# Optional operator-selected DOAJ v4 journal retrieval; public GET requires no key.
DOAJ_API_BASE_URL=https://doaj.org/api/v4
DOAJ_API_TIMEOUT=20
DOAJ_API_CONNECT_TIMEOUT=5
DOAJ_API_ATTEMPTS=3
DOAJ_API_DELAY_MS=1000
DOAJ_API_PAGE_SIZE=10
DOAJ_API_MAX_RESPONSE_BYTES=1048576
DOAJ_API_USER_AGENT="Fikarohana/0.1 (controlled journal ingestion)"
# Use the same hostname for web and API. Production: .your-domain.example.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
# Local HTTP only. Production requires true and HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Official public DOAJ CSV; fixed source URL and validated single redirect.
DOAJ_CSV_TIMEOUT=60
DOAJ_CSV_CONNECT_TIMEOUT=5
DOAJ_CSV_MAX_DOWNLOAD_BYTES=33554432

# Optional operator contact for the Crossref polite pool; do not invent an address.
CROSSREF_API_BASE_URL=https://api.crossref.org
CROSSREF_API_MAILTO=
CROSSREF_API_TIMEOUT=20
CROSSREF_API_CONNECT_TIMEOUT=5

# Optional real OpenAlex key; anonymous singleton access is supported.
OPENALEX_API_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_API_TIMEOUT=20
OPENALEX_API_CONNECT_TIMEOUT=5
